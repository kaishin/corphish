#!/bin/bash
# task-tracker - Track tasks in SQLite database

# Database location
DB_DIR="/workspace/extra/openclaw"
DB_PATH="$DB_DIR/tasks.db"

# Ensure database directory exists
mkdir -p "$DB_DIR"

# Initialize database if it doesn't exist
init_db() {
    if [ ! -f "$DB_PATH" ]; then
        sqlite3 "$DB_PATH" "CREATE TABLE tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            title TEXT UNIQUE NOT NULL,
            status TEXT DEFAULT 'todo',
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
        );"
    fi
}

# List all tasks
list_tasks() {
    init_db
    echo "📋 Tasks:"
    echo "--------"
    sqlite3 "$DB_PATH" "SELECT title, status FROM tasks ORDER BY
        CASE status
            WHEN 'todo' THEN 1
            WHEN 'ongoing' THEN 2
            WHEN 'blocked' THEN 3
            WHEN 'paused' THEN 4
            WHEN 'done' THEN 5
        END, created_at;" | while IFS='|' read -r title status; do
        if [ -n "$title" ]; then
            case "$status" in
                todo) emoji="📝" ;;
                ongoing) emoji="🔄" ;;
                blocked) emoji="🚫" ;;
                paused) emoji="⏸️" ;;
                done) emoji="✅" ;;
                *) emoji="❓" ;;
            esac
            echo "$emoji $title ($status)"
        fi
    done
    if [ -z "$(sqlite3 "$DB_PATH" "SELECT 1 FROM tasks LIMIT 1")" ]; then
        echo "(No tasks)"
    fi
}

# Add a new task
add_task() {
    local title="$1"
    local status="${2:-todo}"

    if [ -z "$title" ]; then
        echo "Error: Task title required" >&2
        echo "Usage: task-tracker add \"Task title\" [status]" >&2
        exit 1
    fi

    init_db
    sqlite3 "$DB_PATH" "INSERT INTO tasks (title, status) VALUES ('$title', '$status');"
    echo "✅ Added: $title ($status)"
}

# Update task status
update_status() {
    local title="$1"
    local status="$2"

    if [ -z "$title" ] || [ -z "$status" ]; then
        echo "Error: Task title and status required" >&2
        echo "Usage: task-tracker status \"Task title\" [blocked|paused|ongoing|done]" >&2
        exit 1
    fi

    # Validate status
    case "$status" in
        todo|blocked|paused|ongoing|done) ;;
        *)
            echo "Error: Invalid status. Use: todo, blocked, paused, ongoing, done" >&2
            exit 1
            ;;
    esac

    init_db
    local count=$(sqlite3 "$DB_PATH" "SELECT COUNT(*) FROM tasks WHERE title = '$title';")
    if [ "$count" -eq 0 ]; then
        echo "Error: Task not found: $title" >&2
        exit 1
    fi

    sqlite3 "$DB_PATH" "UPDATE tasks SET status = '$status', updated_at = CURRENT_TIMESTAMP WHERE title = '$title';"
    echo "✅ Updated: $title → $status"
}

# Delete a task
delete_task() {
    local title="$1"

    if [ -z "$title" ]; then
        echo "Error: Task title required" >&2
        echo "Usage: task-tracker delete \"Task title\"" >&2
        exit 1
    fi

    init_db
    sqlite3 "$DB_PATH" "DELETE FROM tasks WHERE title = '$title';"
    echo "🗑️ Deleted: $title"
}

# Clear all tasks
clear_tasks() {
    init_db
    sqlite3 "$DB_PATH" "DELETE FROM tasks;"
    echo "🗑️ All tasks cleared"
}

# Parse command
COMMAND="$1"
case "$COMMAND" in
    list|ls)
        list_tasks
        ;;
    add)
        add_task "$2" "$3"
        ;;
    status)
        update_status "$2" "$3"
        ;;
    done)
        update_status "$2" "done"
        ;;
    delete|rm)
        delete_task "$2"
        ;;
    clear)
        clear_tasks
        ;;
    *)
        echo "Usage: task-tracker <command> [args]"
        echo ""
        echo "Commands:"
        echo "  list                      # List all tasks"
        echo "  add \"Title\" [status]      # Add new task (default: ongoing)"
        echo "  status \"Title\" ongoing     # Update task status"
        echo "  done \"Title\"               # Mark task as done"
        echo "  delete \"Title\"            # Delete a task"
        echo "  clear                     # Delete all tasks"
        echo ""
        echo "Statuses: todo, blocked, paused, ongoing, done"
        exit 1
        ;;
esac
